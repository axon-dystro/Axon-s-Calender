<form class="ac-config-shell">
  <header class="ac-config-hero">
    <div>
      <span class="ac-eyebrow">WORLD CALENDAR SYSTEM</span>
      <h1>{{config.name}}</h1>
      <p>Dein Kalender bleibt in dieser Foundry-Welt gespeichert. Kein Code, kein externer Dienst.</p>
    </div>
    <div class="ac-config-presets"><button type="button" data-action="world-rules">Sonne, Timer & Weltregeln</button>
      <button type="button" data-action="preset-illidor"><i class="fa-solid fa-gem"></i> Illidor-Preset</button>
      <button type="button" data-action="preset-blank"><i class="fa-solid fa-file-circle-plus"></i> Leerer Kalender</button>
    </div>
  </header>

  <nav class="ac-config-tabs" aria-label="Bereiche">
    {{#each tabs}}
      <button type="button" data-tab="{{id}}" class="{{#if active}}active{{/if}}"><i class="fa-solid {{icon}}"></i><span>{{label}}</span></button>
    {{/each}}
  </nav>

  {{#if message}}
    <div class="ac-config-message {{#if message.error}}is-error{{else}}is-success{{/if}}">{{message.text}}</div>
  {{/if}}

  <main class="ac-config-body">
    <section class="ac-config-panel {{#unless tabs.0.active}}is-hidden{{/unless}}" data-panel="general">
      <div class="ac-section-heading"><div><span>01</span><h2>Identität & aktueller Zeitpunkt</h2></div><p>Was deine Spieler sehen und wo die Kampagne gerade steht.</p></div>
      <div class="ac-form-grid">
        <label><span>Kalendername</span><input name="calendarName" value="{{config.name}}" maxlength="80" required></label>
        <label><span>Zeitrechnung</span><input name="eraLabel" value="{{config.eraLabel}}" maxlength="24" placeholder="z. B. e.e."></label>
        <label class="span-2"><span>Kurze Beschreibung</span><textarea name="calendarDescription" rows="2" maxlength="500">{{config.description}}</textarea></label>
      </div>

      <div class="ac-section-heading compact"><div><span>02</span><h2>Designfarben</h2></div><p>Beide Farben werden auf Glas, Leuchten, Schalter, Auswahlflächen und Akzente angewendet.</p></div>
      <div class="ac-theme-builder" style="--theme-primary: {{config.theme.primary}}; --theme-secondary: {{config.theme.secondary}}">
        <label><span>Primärfarbe</span><input type="color" name="themePrimary" value="{{config.theme.primary}}" data-theme-color></label>
        <label><span>Sekundärfarbe</span><input type="color" name="themeSecondary" value="{{config.theme.secondary}}" data-theme-color></label>
        <div class="ac-theme-preview" aria-label="Vorschau"><span></span><strong>GLASS THEME</strong><i></i></div>
      </div>

      <div class="ac-now-card">
        <div class="ac-now-orb"><i class="fa-solid fa-location-crosshairs"></i></div>
        <div class="ac-now-fields">
          <label><span>Art</span><select name="currentKind"><option value="regular" {{#if state.isRegular}}selected{{/if}}>Normaler Tag</option><option value="special" {{#if state.isSpecial}}selected{{/if}}>Sondertag</option></select></label>
          <label><span>Jahr</span><input type="number" name="currentYear" value="{{state.year}}" step="1"></label>
          <label><span>Jahreszeit</span><select name="currentSeason">{{#each state.seasons}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{name}}</option>{{/each}}</select></label>
          <div class="ac-now-regular {{#if state.isSpecial}}is-hidden{{/if}}" data-current-regular>
            <label><span>Monat</span><select name="currentMonth">{{#each state.months}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{name}}</option>{{/each}}</select></label>
            <label><span>Tag</span><select name="currentDay">{{#each state.days}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{value}}</option>{{/each}}</select></label>
          </div>
          <label><span>Sondertag (bei Art Sondertag)</span><select name="currentSpecial">{{#each currentSpecials}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{name}}</option>{{/each}}</select></label>
          <label><span>Uhrzeit</span><input type="text" name="currentTime" value="{{state.time}}" inputmode="numeric" pattern="[0-9]+:[0-9]+" placeholder="21:00"></label>
        </div>
      </div>

      <div class="ac-section-heading compact"><div><span>03</span><h2>Wochenrhythmus</h2></div></div>
      <div class="ac-form-grid">
        <label><span>Wochenreset</span><select name="weekReset">{{#each weekResetOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>
        <label><span>Erster Wochentag (Index ab 0)</span><input type="number" name="firstWeekday" value="{{config.week.firstWeekday}}" min="0" max="59"></label>
        <label class="span-2"><span>Wochentage · ein Name pro Zeile</span><textarea name="weekdays" rows="8" required>{{weekdaysText}}</textarea></label>
        <label class="ac-check span-2"><input type="checkbox" name="specialDaysAdvance" {{#if config.week.specialDaysAdvance}}checked{{/if}}><span>Sondertage verschieben den Wochenrhythmus um einen Tag</span></label>
      </div>
    </section>

    <section class="ac-config-panel {{#unless tabs.1.active}}is-hidden{{/unless}}" data-panel="structure">
      <div class="ac-section-heading"><div><span>04</span><h2>Jahreszeiten, Monate & Sondertage</h2></div><p>Jede Jahreszeit kann ihre eigenen Monate und Monatslängen haben.</p></div>
      <div class="ac-season-list">
        {{#each seasons}}
          <article class="ac-season-builder" data-season-row data-season-index="{{index}}" style="--season-color: {{color}}">
            <header>
              <span class="ac-season-number">{{number}}</span>
              <input data-season-name value="{{name}}" maxlength="80" aria-label="Name der Jahreszeit">
              <input data-season-color type="color" value="{{color}}" aria-label="Farbe der Jahreszeit">
              <button type="button" class="icon danger" data-action="remove-season" data-season="{{index}}" title="Jahreszeit entfernen"><i class="fa-solid fa-trash"></i></button>
            </header>
            <div class="ac-month-list">
              {{#each months}}
                <div class="ac-month-row" data-month-row>
                  <span>M{{number}}</span>
                  <input data-month-name value="{{name}}" maxlength="80" aria-label="Monatsname">
                  <input data-month-color type="color" value="{{color}}" aria-label="Monatsfarbe">
                  <label><input data-month-days type="number" value="{{days}}" min="1" max="999"><small>Tage</small></label>
                  <button type="button" class="icon" data-action="remove-month" data-season="{{../index}}" data-month="{{index}}" title="Monat entfernen"><i class="fa-solid fa-xmark"></i></button>
                </div>
              {{/each}}
              <button type="button" class="ac-add-row" data-action="add-month" data-season="{{index}}"><i class="fa-solid fa-plus"></i> Monat hinzufügen</button>
            </div>
            <div class="ac-special-builder">
              <label class="ac-check"><input data-special-enabled type="checkbox" {{#if specialDay.enabled}}checked{{/if}}><span>Sondertag nach dieser Jahreszeit</span></label>
              <input data-special-name value="{{specialDay.name}}" maxlength="80" placeholder="Name des Sondertags">
              <label class="ac-check"><input data-special-outside type="checkbox" {{#if specialDay.outsideYear}}checked{{/if}}><span>Liegt zwischen den Jahren</span></label>
              <textarea data-special-description rows="2" maxlength="1000" placeholder="Beschreibung">{{specialDay.description}}</textarea>
            </div>
          </article>
        {{/each}}
      </div>
      <button type="button" class="ac-big-add" data-action="add-season"><i class="fa-solid fa-plus"></i> Jahreszeit hinzufügen</button>
    </section>

    <section class="ac-config-panel {{#unless tabs.2.active}}is-hidden{{/unless}}" data-panel="moons">
      <div class="ac-section-heading"><div><span>05</span><h2>Monde & Zyklen</h2></div><p>Null Monde ist ebenfalls erlaubt. Klima und Wetter kommen später als getrennte Erweiterung.</p></div>
      <div class="ac-moon-list">
        {{#each moons}}
          <article class="ac-moon-builder" data-moon-row style="--moon-color: {{color}}">
            <div class="ac-moon-preview">{{number}}</div>
            <div class="ac-moon-fields">
              <label><span>Name</span><input data-moon-name value="{{name}}" maxlength="60"></label>
              <label><span>Zyklus in Tagen</span><input data-moon-cycle type="number" value="{{cycleDays}}" min="1" max="10000" step="0.1"></label>
              <label><span>Versatz</span><input data-moon-offset type="number" value="{{offsetDays}}" min="-10000" max="10000" step="0.1"></label>
              <label><span>Farbe</span><input data-moon-color type="color" value="{{color}}"></label>
              <label><span>Name der dunkelsten Phase</span><input data-moon-turning value="{{turningLabel}}" maxlength="60"></label>
              <label class="ac-check"><input data-moon-special type="checkbox" {{#if fullOnSpecialDays}}checked{{/if}}><span>Vollmond an Sondertagen</span></label>
              <label class="ac-check"><input data-moon-always type="checkbox" {{#if alwaysVisibleOnOutsideYear}}checked{{/if}}><span>Außerhalb des Jahres immer sichtbar</span></label>
            </div>
            <button type="button" class="icon danger" data-action="remove-moon" data-moon="{{index}}" title="Mond entfernen"><i class="fa-solid fa-trash"></i></button>
          </article>
        {{else}}
          <div class="ac-empty-builder"><i class="fa-regular fa-moon"></i><p>Dieser Kalender hat noch keinen Mond.</p></div>
        {{/each}}
      </div>
      <button type="button" class="ac-big-add" data-action="add-moon"><i class="fa-solid fa-plus"></i> Mond hinzufügen</button>
    </section>

    <section class="ac-config-panel {{#unless tabs.3.active}}is-hidden{{/unless}}" data-panel="phases">
      <div class="ac-section-heading"><div><span>06</span><h2>Uhr & Tagesphasen</h2></div><p>Die Uhr darf auch von einem 24-Stunden-Tag abweichen.</p></div>
      <div class="ac-form-grid ac-time-basics">
        <label><span>Stunden pro Tag</span><input type="number" name="hours" value="{{config.day.hours}}" min="1" max="100"></label>
        <label><span>Minuten pro Stunde</span><input type="number" name="minutesPerHour" value="{{config.day.minutesPerHour}}" min="1" max="100"></label>
        <label><span>Schrittweite der Uhr</span><input type="number" name="stepMinutes" value="{{config.day.stepMinutes}}" min="1"></label>
        <label><span>Phase nach „Nächster Tag“</span><select name="nextDayPhaseId">{{#each phaseChoices}}<option value="{{id}}" {{#if selected}}selected{{/if}}>{{icon}} {{name}}</option>{{/each}}</select></label>
      </div>
      <div class="ac-phase-list">
        {{#each phases}}
          <article class="ac-phase-row" data-phase-row style="--phase-color: {{color}}">
            <input data-phase-icon class="ac-icon-input" value="{{icon}}" maxlength="12" aria-label="Symbol">
            <label><span>Name</span><input data-phase-name value="{{name}}" maxlength="60"></label>
            <label><span>Technische ID</span><input data-phase-id value="{{id}}" maxlength="80"></label>
            <label><span>Beginn</span><input data-phase-time type="text" value="{{startTime}}" inputmode="numeric" pattern="[0-9]+:[0-9]+"></label>
            <label><span>Farbe</span><input data-phase-color type="color" value="{{color}}"></label>
            <label><span>Dunkelheit 0–1</span><input data-phase-darkness type="number" value="{{darkness}}" min="0" max="1" step="0.05"></label>
            <button type="button" class="icon danger" data-action="remove-phase" data-phase="{{index}}" title="Phase entfernen"><i class="fa-solid fa-trash"></i></button>
          </article>
        {{/each}}
      </div>
      <button type="button" class="ac-big-add" data-action="add-phase"><i class="fa-solid fa-plus"></i> Tagesphase hinzufügen</button>
    </section>

    <section class="ac-config-panel {{#unless tabs.4.active}}is-hidden{{/unless}}" data-panel="features">
      <div class="ac-section-heading"><div><span>07</span><h2>Module & Verhalten</h2></div><p>Alles bleibt einzeln abschaltbar. Die Szenenhelligkeit ist absichtlich opt-in.</p></div>
      <div class="ac-feature-grid">
        {{#each features}}
          <label class="ac-feature-card">
            <input type="checkbox" name="feature.{{key}}" {{#if checked}}checked{{/if}}>
            <span class="ac-switch"></span>
            <strong>{{label}}</strong>
            <small>{{hint}}</small>
          </label>
        {{/each}}
      </div>
      <div class="ac-transfer-card">
        <div><i class="fa-solid fa-box-archive"></i><div><strong>Kalender sichern oder teilen</strong><small>Export enthält Struktur, Zeitpunkt und Modulschalter – keine Ereignisse oder privaten Notizen.</small></div></div>
        <div class="ac-transfer-actions">
          <button type="button" data-action="export"><i class="fa-solid fa-download"></i> JSON exportieren</button>
          <button type="button" data-action="open-import"><i class="fa-solid fa-upload"></i> JSON importieren</button>
          <input class="is-hidden" type="file" accept="application/json,.json" data-action="import-file">
        </div>
      </div>
    </section>
  </main>

  <footer class="ac-config-footer">
    <span><i class="fa-solid fa-shield-halved"></i> {{#if isGM}}Weltkonfiguration speichern{{else}}Nur freigegebene Änderungen werden an den Haupt-GM übergeben.{{/if}}</span>
    <button type="submit" class="primary"><i class="fa-solid fa-floppy-disk"></i> Kalender speichern</button>
  </footer>
</form>
